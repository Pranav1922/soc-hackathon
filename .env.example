# Copy to `.env` (which is gitignored) and fill in. Never commit real keys.
# See FINAL_ARCHITECTURE_DECISIONS.md D16 — provider is swappable and free-tier.

# ── LLM (the single LLM call: Query Understanding) ───────────────────────────
LLM_PROVIDER=groq                      # groq | gemini | ollama
LLM_API_KEY=your_free_api_key_here     # required for groq/gemini; leave blank for ollama
LLM_MODEL=llama-3.3-70b-versatile      # provider-specific model id
LLM_TIMEOUT_SECONDS=8.0                # D2: 8s timeout, then keyword-extractor fallback
LLM_MAX_RETRIES=1

# ── API (OPTIONAL — Streamlit runs the agent in-process by default, D13) ─────
API_HOST=0.0.0.0
API_PORT=8000

# ── Data ─────────────────────────────────────────────────────────────────────
DATASET_PATH=data/sample/transactions.parquet

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
